   "source": [
    "#Mask a mobile number so only the last 4 digits are visible\n",
    "\n",
    "num=input(\"enter your phone number\")\n",
    "\n",
    "masked=\"*\" * (len(num)-4) + num[-4:]\n",
    "print(masked)"
   ]
