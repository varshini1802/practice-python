   "source": [
    "#Count how many times a particular character appears in a string \n",
    "\n",
    "string=input(\"enter a string\")\n",
    "char=input(\"enter a letter to count\")\n",
    "count=0\n",
    "for i in string:\n",
    "    if i==char:\n",
    "        count=count+1\n",
    "print(\"The character\",char,\"appears\",count,\"times\")"
   ]
