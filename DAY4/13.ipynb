    "#Validate whether an entered string looks like a valid email using basic string checks\n",
    "\n",
    "x=input(\"enter your email\")\n",
    "\n",
    "if \"@\" in x and \".\" in x:\n",
    "    print(\"The email is valid\")\n",
    "else:\n",
    "    print(\"The email is invalid\")"
   ]
