    "#Extract only the digits from a given alphanumeric string\n",
    "\n",
    "text=input(\"enter the alphanumeric string\")\n",
    "\n",
    "for i in text:\n",
    "    if i.isdigit():\n",
    "        print(i,end=\"\")"
