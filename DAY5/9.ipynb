   "source": [
    "#Convert a list of words into a dictionary mapping each word to its length (Medium)\n",
    "\n",
    "words=[\"Red\",\"orange\",\"blue\",\"green\",\"black\"]\n",
    "result={}\n",
    "\n",
    "for i in words:\n",
    "    result[i]=len(i)\n",
    "\n",
    "print(result)"
   ]
