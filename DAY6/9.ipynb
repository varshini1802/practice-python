   "source": [
    "#Write student records to a CSV file using the csv module (Medium)\n",
    "\n",
    "import csv\n",
    "\n",
    "file=open(\"students.csv\",\"w\", newline=\"\")\n",
    "\n",
    "writer=csv.writer(file)\n",
    "writer.writerow(['Name','marks'])\n",
    "writer.writerow(['Asha',98])\n",
    "writer.writerow(['John',77])\n",
    "writer.writerow(['Rohit',67])\n",
    "\n",
    "file.close()"
   ]
