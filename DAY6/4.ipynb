   "source": [
    "#Create and raise a custom exception for an invalid age value\n",
    "\n",
    "class InvalidAgeError(Exception):\n",
    "    pass\n",
    "\n",
    "age=int(input(\"Enter your age\"))\n",
    "\n",
    "if age<0:\n",
    "    raise InvalidAgeError(\"Age cannot be negative\")\n",
    "\n",
    "print(\"Valid age\")\n"
   ]
