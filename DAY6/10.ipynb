   "source": [
    "#Read data back from a CSV file and display it in a formatted way\n",
    "import csv\n",
    "file=open(\"students.csv\",\"r\")\n",
    "\n",
    "reader=csv.reader(file)\n",
    "\n",
    "for row in reader:\n",
    "    print(row[0],\"-\",row[1])\n",
    "\n",
    "file.close()"
   ]
  }
