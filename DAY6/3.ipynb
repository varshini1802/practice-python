   "source": [
    "#Write a program using try-except-else-finally to understand the execution flow (Medium)\n",
    "\n",
    "try:\n",
    "    num=int(input(\"enter a number:\"))\n",
    "except ValueError:\n",
    "    print(\"Invalid\")\n",
    "else:\n",
    "    print(\"You entered\",num)\n",
    "finally:\n",
    "    print(\"program finished\")"
   ]
  }
