   "source": [
    "#swap 2 numbers using 3rd variable\n",
    "a=int(input(\"enter first number:\"))\n",
    "b=int(input(\"enter second number:\"))\n",
    "print(f\"Before swapping a={a}, b={b}\")\n",
    "temp=a\n",
    "a=b\n",
    "b=temp\n",
    "\n",
    "print(f\"After swapping a={a}, b={b}\")"
   ]
  }
