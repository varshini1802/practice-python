    "#Check whether a number entered by the user is positive, negative, or zero \n",
    "\n",
    "a=float(input(\"Enter any number:\"))\n",
    "if a<0:\n",
    "    print(\"it is negative number\")\n",
    "elif a>0:\n",
    "    print(\"it is positive number\")\n",
    "else:\n",
    "    print(\"the number is 0\")"
