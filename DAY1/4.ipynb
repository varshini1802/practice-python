   "source": [
    "#Take a person's age as input and print if they are a minor, adult, or senior citizen\n",
    "\n",
    "age=int(input(\"Enter a person's age: \"))\n",
    "\n",
    "if age<18:\n",
    "    print(\"The person is minor\")\n",
    "elif age>18 and age<60:\n",
    "    print(\"The person is Adult\")\n",
    "else:\n",
    "    print(\"The person is Senior citizen\")\n"
   ]
