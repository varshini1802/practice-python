   "source": [
    "#Calculate simple interest given principal, rate, and time\n",
    "\n",
    "p=float(input(\"enter principal amount:\"))\n",
    "r=float(input(\"enter rate:\"))\n",
    "t=float(input(\"enter time:\"))\n",
    "\n",
    "si=(p*t*r)/100\n",
    "print(\"simple interest=\",round(si,3))\n",
    "\n"
   ]
