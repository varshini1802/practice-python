   "source": [
    "#Check whether a given year is a leap year\n",
    "\n",
    "year=int(input(\"enter year:\"))\n",
    "\n",
    "if (year%4==0 and year%100!=0) or (year%400==0):\n",
    "    print(\"The\",year, \"is leap year\")\n",
    "else:\n",
    "    print(\"The\",year, \"is not a leap year\")"
   ]
