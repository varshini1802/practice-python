   "source": [
    "#Convert a given number of seconds into hours, minutes, and seconds \n",
    "\n",
    "x=int(input(\"Enter the total seconds: \"))\n",
    "hr=x//3600\n",
    "remainder=x%3600\n",
    "min=remainder//60\n",
    "sec=remainder%60\n",
    "\n",
    "print(f\"{x} seconds = {hr} hours,{min} minutes,{sec} seconds\")"
   ]
  }
 ],
