   "source": [
    "#Print a checkerboard pattern in python\n",
    "\n",
    "n=int(input(\"enter the size\"))\n",
    "\n",
    "for i in range(n):\n",
    "    for j in range(n):\n",
    "        if (i+j)%2==0:\n",
    "            print('*', end=\" \")\n",
    "        else:\n",
    "            print(\" \",end=\" \")\n",
    "    print()\n"
   ]
