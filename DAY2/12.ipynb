   "source": [
    "#Print all Armstrong numbers between 1 and 500\n",
    "\n",
    "for num in range(0,501):\n",
    "    temp=num\n",
    "    total=0\n",
    "\n",
    "    while temp>0:\n",
    "        digit=temp%10\n",
    "        total=total+digit**3\n",
    "        temp=temp//10\n",
    "    if total==num:\n",
    "        print(total)"
   ]
