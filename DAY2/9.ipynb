   "source": [
    "#Take 5 numbers one by one and print the sum of digits of each \n",
    "for num in range(5):\n",
    "    num=int(input(\"enter the number\"))\n",
    "    sum=0\n",
    "\n",
    "    while num>0:\n",
    "        digit=num%10\n",
    "        sum=sum+digit\n",
    "        num=num//10\n",
    "\n",
    "    print(\"the sum of digits:\",sum)\n"
   ]
