   "source": [
    "#Take a number and check whether it's prime using only loops\n",
    "\n",
    "a=int(input(\"enter a number\"))\n",
    "if a<=1:\n",
    "    print(\"not prime\")\n",
    "else:\n",
    "    for i in range(2,a):\n",
    "        if a%i==0:\n",
    "            print(\"not prime\")\n",
    "            break\n",
    "    else:\n",
    "        print(\"it's a prime number\")\n",
    "\n"
   ]
