    "#Calculate factorial using a loop, then rewrite it using functools.reduce (Hard)\n",
    "\n",
    "def fact(n):\n",
    "\n",
    "    if fact<=1:\n",
    "        return 1\n",
    "    else:\n",
    "        n=n*fact(n-1)\n",
    "        return n\n",
    "\n",
    "n=int(input(\"Enter a number\"))\n",
    "print(fact)\n"
