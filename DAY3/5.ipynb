   "source": [
    "#Write a function with a default argument to calculate simple interest (Medium)\n",
    "\n",
    "def simple_interest(p,r=2,t=5):\n",
    "    si=(p*t*r)/100\n",
    "    return si\n",
    "\n",
    "\n",
    "simple_interest(4200,4,2)"
   ]
