   "source": [
    "#Write a function using *args that returns the sum of any number of values (Medium)\n",
    "def sum(*num):\n",
    "    add=0\n",
    "    for i in num:\n",
    "        add=add+i\n",
    "    return add\n",
    "print(sum(7,3,7,2,70,55))"
   ]
  }
