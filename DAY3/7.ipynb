   "source": [
    "#Write a function using **kwargs that prints all key-value pairs passed to it (Medium)\n",
    "\n",
    "def details(**info):\n",
    "    for key,value in info.items():\n",
    "        print(key,value)\n",
    "\n",
    "print(details(name=\"Rahul\",age=21,country=\"India\"))"
   ]
